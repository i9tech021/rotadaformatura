# ============================================================
# Rota da Formatura — exemplo de variáveis de ambiente
# COPIE para `.env` (que NÃO é versionado) e preencha com valores reais.
# NUNCA comite segredos reais. O `.env` está no .gitignore.
# ============================================================

# Supabase (Frente 1) — valores reais ficam em `.env` / config do Lovable
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA_AQUI

# IA (Tutor) — OpenRouter (OpenAI-compatible, funciona no deploy do Lovable)
# Chave gratuita em https://openrouter.ai/keys
# AVISO: VITE_AI_API_KEY é secreta. Só é lida DENTRO de server functions
# (src/lib/academic.functions.ts) — NUNCA a referencie em componentes de tela.
# Modelos free testados e funcionando: nvidia/nemotron-3.5-lightning:free,
# nvidia/nemotron-3-ultra-550b-a55b:free, google/gemma-4-26b-a4b-it:free.
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_API_KEY=SUA_CHAVE_OPENROUTER_AQUI
VITE_AI_MODEL=nvidia/nemotron-3.5-lightning:free
